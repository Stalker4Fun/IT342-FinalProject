# EcoBite Backend Environment Variables (Example)
# Copy this file to .env and adjust the values as needed

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://127.0.0.1:5432/ecobite_db
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_postgres

# JWT Security Configuration (Secret must be at least 32 characters / 256 bits)
JWT_SECRET=CHANGE_ME_ecobite_super_secret_jwt_key_it342_2026_at_least_32_chars
JWT_EXPIRATION_MINUTES=60

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin Bootstrap Account (Initial seeded system administrator)
ADMIN_NAME=EcoBite System Admin
ADMIN_EMAIL=admin@ecobite.org
ADMIN_PASSWORD=CHANGE_ME_Admin123!

# SMTP / Mailpit Configuration (Default local Mailpit: host=localhost, port=1025, UI=http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ecobite.local
MAIL_AUTH=false
MAIL_STARTTLS=false

# Frontend URL & Password Reset Token Expiration
FRONTEND_BASE_URL=http://localhost:5173
RESET_TOKEN_EXPIRATION_MINUTES=15
